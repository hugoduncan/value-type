{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}}
 :aliases
 {:fallback-test {:extra-paths ["test/compatibility"]
                  :extra-deps {org.hugoduncan/scry {:mvn/version "0.1.61"}}
                  :main-opts ["-m" "scry.cli" "--dir" "test/compatibility"]}
  :cross-jvm-test {:extra-paths ["test/cross-jvm" "test/compatibility"]
                   :extra-deps {org.hugoduncan/scry {:mvn/version "0.1.61"}}
                   :main-opts ["-m" "scry.cli" "--dir" "test/cross-jvm"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}}
          :ns-default build}
  :deploy {:extra-deps {slipset/deps-deploy {:mvn/version "0.2.2"}}}
  :release {:extra-paths ["dev/release"]}
  :release-test {:extra-paths ["test/release"]
                 :extra-deps {org.hugoduncan/scry {:mvn/version "0.1.61"}}}
  :build-test {:extra-paths ["." "test/build"]
               :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.10"}
                            org.hugoduncan/scry {:mvn/version "0.1.61"}}
               :jvm-opts ["--enable-preview"]}
  :test {:extra-paths ["test/runtime"]
         :extra-deps {org.hugoduncan/scry {:mvn/version "0.1.61"}}
         :jvm-opts ["--enable-preview"]}
  :bench {:extra-paths ["bench"]
          :extra-deps {org.hugoduncan/criterium {:mvn/version "0.5.253-ALPHA"}}
          :jvm-opts ["--enable-preview"
                     "-XX:+UnlockExperimentalVMOptions"
                     "-XX:CompileCommand=blackhole,criterium.blackhole.Blackhole::consume"]}
  :object-size {:extra-paths ["bench"]
                :extra-deps {org.hugoduncan/criterium {:mvn/version "0.5.253-ALPHA"}}
                :jvm-opts ["--enable-preview"]}
  :quickdoc {:extra-paths ["bb"]
             :extra-deps {io.github.borkdude/quickdoc
                          {:git/tag "v0.2.6"
                           :git/sha "ce8678000afa5f835639dd7267dc191fd90495a2"}}}
  :tooling-test {:extra-paths ["test/tooling"]
                 :extra-deps {org.hugoduncan/scry {:mvn/version "0.1.61"}}}
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}}}
